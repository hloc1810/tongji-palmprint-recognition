# Python and local environments
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv*/
.runtime/
.cache/
.ipynb_checkpoints/
build/
dist/
validation/

# Editor settings, local credentials and machine configuration
.vscode/
.idea/
.agents/
.codex/
.aws/
.env
.env.*
!.env.example
*.pem
*.key
.DS_Store
Thumbs.db

# Tongji biometric images, metadata, feature caches and model weights stay local.
data/raw/**
!data/raw/.gitkeep
data/metadata/**
!data/metadata/.gitkeep
data/splits/**
!data/splits/.gitkeep
artifacts/**
!artifacts/.gitkeep
outputs/
*.pth
*.pt
*.ckpt
*.joblib
*.npz
*.npy

# Publish only the reviewed aggregate benchmark tables and scientific plots.
reports/tables/*
!reports/tables/.gitkeep
!reports/tables/tongji_benchmark.csv
!reports/tables/tongji_benchmark_summary.csv
!reports/tables/tongji_cv_grid_summary.csv
!reports/tables/model_comparison.csv
!reports/tables/cv_selection_summary.csv
!reports/tables/cnn_seed_results.csv
!reports/tables/cnn_seed_summary.csv
!reports/tables/cnn_cpu_latency.csv
!reports/tables/cnn_mean_vs_classical_paired.csv
!reports/tables/cnn_each_seed_vs_classical_paired.csv
!reports/tables/paired_rank1_differences.csv
!reports/tables/evidence_verification.csv
reports/figures/*
!reports/figures/.gitkeep
!reports/figures/cnn_training_curves.png
!reports/figures/cnn_vs_classical_cmc_rank20.png
