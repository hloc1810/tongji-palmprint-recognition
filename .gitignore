# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
.venv*/
venv/
ENV/

# Testing and cache
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Operating System files
.DS_Store
Thumbs.db

# Heavy raw biometric dataset (excluded from GitHub, kept locally)
data/raw/**
!data/raw/.gitkeep

# Exclude duplicate verification view and intermediate dev checkpoints
outputs/cnn_experiments/verification_view/
outputs/runs/*/best_dev.pth

# Intermediate feature caches
outputs/cache/
outputs/feature_ablation/cache/

